# Copy this file to scripts/macos/frontier_random050_50x24_h5.env and edit
# paths for the macOS machine before running the experiment script.

# Full Bishan prepared-data root. This directory must contain:
# tool2/transitions.npz
# tool2/pairwise.npz
# dem_slope_analysis/output/DLTB_with_slope.gpkg or .shp
# results_real/blocks/
# townships.json
DATA_ROOT=/Volumes/paper10_data/full_bishan

# Output root outside the Git checkout. The runner creates one run directory
# under this location and stores logs, reports, checkpoints, labels, and ZIPs.
RUN_ROOT=$HOME/paper10_runs

# Python executable. Use .venv/bin/python after creating the local venv.
PYTHON_BIN=python3

# Use cpu by default for maximum macOS compatibility. You may try mps on Apple
# Silicon after the smoke tests pass, but CPU is the conservative default.
DEVICE=cpu

# Optional multiseed extension. Set to 1 to run seeds 1-4 after seed 0.
RUN_OPTIONAL_SEEDS=0

# Target experiment scale.
N_STATES=50
CANDIDATE_ACTIONS=24
LABEL_HORIZON=5
LABEL_SEED=45
TRAINING_SEED=3045
